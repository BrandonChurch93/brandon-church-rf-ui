{
  "name": "brandon-church-rf-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "seed": "node scripts/generate-seed.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "PW_DEV_SERVER=1 playwright test tests/visual --project=chromium",
    "gate:faithful": "node -e \"require('fs').rmSync('tests/gates/__out__/faithful-results.json',{force:true})\" && playwright test tests/gates/faithful.spec.ts --project=chromium",
    "gate:a11y": "node -e \"require('fs').rmSync('tests/gates/__out__/a11y.json',{force:true})\" && playwright test tests/gates/a11y.spec.ts --project=chromium",
    "gate:motion": "node -e \"require('fs').rmSync('tests/gates/__out__/motion-results.json',{force:true})\" && playwright test tests/gates/motion.spec.ts --project=chromium",
    "gate:build": "npm run build && node scripts/verify-build.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "npm run verify && node scripts/package.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "archiver": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "sass": "^1.108.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
